    { "id": "perk_impact", "name": "衝撃強化",       "description": "武器のノックバック+15%",
      "effects": [ { "target": "weapon.knockback", "op": "mul", "value": 1.15 } ] },
    { "id": "perk_tuning", "name": "スキル調整",     "description": "スキルの性能+10%",
