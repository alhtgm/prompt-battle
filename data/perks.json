    { "id": "perk_power",  "name": "火力強化",       "description": "武器のダメージ+10%",
      "effects": [ { "target": "weapon.damage", "op": "mul", "value": 1.10 } ] },
    { "id": "perk_wheels", "name": "足回り調整",     "description": "移動速度の低下を20%減らす",
